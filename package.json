{
  "name": "band-organizer",
  "private": true,
  "version": "0.18.1",
  "type": "module",
  "description": "Overload App – PWA for band organization on top of HiDrive",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "map": "node scripts/gen-code-index.mjs",
    "serve": "node scripts/serve.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "i18next": "^25.10.10",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.18.4",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "http_ece": "^1.2.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
